# AskHari.ai — copy this file to .env for local `netlify dev` testing.
# In production, set these as environment variables in the Netlify site dashboard.

# Primary provider (Anthropic Claude API)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Fallback provider, used if the Anthropic call fails or ANTHROPIC_API_KEY is unset
# (https://openrouter.ai — can route to free open-source models)
OPENROUTER_API_KEY=
# Trench AI (netlify/functions/ask-writing.js) tries a built-in list of free
# models in order, ending with the "openrouter/free" router. If set, this
# model is tried first. AskHari.ai's fallback uses it instead of openrouter/free.
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Netlify build hook URL (Site configuration -> Build & deploy -> Build hooks).
# netlify/functions/newsletter-rebuild.mjs POSTs to it when a new Substack
# edition is out, so /newsletter/ and the hub update on their own. Secret.
NEWSLETTER_BUILD_HOOK=

# Guide sign-up with email codes (netlify/functions/guide-otp.mjs).
# Resend (https://resend.com) sends the 6-digit codes; verify the domain there
# (DNS records on harisankarsivankutty.in) so codes come from your domain.
RESEND_API_KEY=
# RESEND_FROM=BrainByte <codes@harisankarsivankutty.in>
# A long random string (e.g. `openssl rand -hex 32`). Signs the unlock cookie
# that lets guide PDFs download. Set it together with RESEND_API_KEY: once it is
# set, PDFs need a verified sign-up.
OTP_SECRET=
# Under netlify dev, verified test emails are NOT sent to Substack unless this is 1.
# GUIDE_OTP_SUBSTACK=1
