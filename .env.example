# AskHari.ai — copy this file to .env for local `netlify dev` testing.
# In production, set these as environment variables in the Netlify site dashboard.

# Primary provider (Anthropic Claude API)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Fallback provider, used if the Anthropic call fails or ANTHROPIC_API_KEY is unset
# (https://openrouter.ai — can route to free open-source models)
OPENROUTER_API_KEY=
# Ask My Writing (netlify/functions/ask-writing.js) tries a built-in list of
# free models in order. Set this to pin it to a single model instead.
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
