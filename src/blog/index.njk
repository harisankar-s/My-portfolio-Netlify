---
title: Notes from the data trenches
description: "A Thoughtworks consultant writes about data engineering and AI engineering — the patterns, trade-offs, and hard-won lessons from 10+ years building data platforms and GenAI systems for enterprise clients."
permalink: /
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="author" content="Harisankar Sivankutty" />
  <meta name="theme-color" content="#F9F8F4" />
  <meta name="description" content="{{ description }}" />
  <meta property="og:title" content="Harisankar Sivankutty — Notes from the data trenches" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:type" content="website" />
  <title>Harisankar Sivankutty — Notes from the data trenches</title>
  <link rel="icon" href="/images/favicon.png" type="image/png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:           #F9F8F4;
      --bg-elevated:  #F0EEE6;
      --surface:      #E8E6DC;
      --border:       rgba(0, 0, 0, 0.08);
      --border-mid:   rgba(0, 0, 0, 0.13);
      --fg:           #1A1A18;
      --fg-muted:     #4A4A44;
      --fg-dim:       #8A8A80;
      --accent:       #B8910A;
      --accent-dim:   rgba(184, 145, 10, 0.10);
      --accent-glow:  rgba(184, 145, 10, 0.22);

      --font-sans:  'Inter', system-ui, -apple-system, sans-serif;
      --font-serif: 'Instrument Serif', 'Georgia', serif;
      --font-mono:  'JetBrains Mono', ui-monospace, monospace;

      --sidebar-w: 240px;
      --max-w:     1200px;
      --pad-x:     clamp(20px, 4vw, 56px);
      --ease:      cubic-bezier(0.22, 1, 0.36, 1);
    }

    html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }

    body {
      background: var(--bg);
      color: var(--fg);
      font-family: var(--font-sans);
      font-size: 15px;
      line-height: 1.6;
      overflow-x: hidden;
      min-height: 100vh;
    }

    body::before {
      content: ''; position: fixed; inset: 0;
      pointer-events: none; z-index: 0;
      opacity: 0.025; mix-blend-mode: multiply;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    }

    a { color: inherit; text-decoration: none; transition: color 0.2s var(--ease); }
    img { display: block; max-width: 100%; }
    ::selection { background: var(--accent); color: var(--bg); }

    /* ── NAV ─────────────────────────────────────────────────────── */
    .nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      padding: 0 var(--pad-x);
      height: 56px;
      display: flex; align-items: center; justify-content: space-between;
      background: #1E1B15;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      transition: background 0.3s var(--ease), border-color 0.3s var(--ease);
    }
    .nav.scrolled { background: rgba(28,24,18,0.97); border-bottom-color: rgba(255,255,255,0.09); }

    .nav-brand {
      display: flex; align-items: center; gap: 10px;
      font-family: var(--font-mono); font-size: 13px; font-weight: 500;
      color: #EDE9E0; letter-spacing: -0.01em;
      text-decoration: none;
    }
    .nav-brand .dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--accent); box-shadow: 0 0 10px var(--accent-glow);
      animation: pulse 2.6s ease-in-out infinite;
    }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.45;transform:scale(0.8)} }

    .nav-right { display: flex; align-items: center; gap: 8px; }

    .nav-link {
      font-family: var(--font-sans); font-size: 13.5px; font-weight: 500;
      color: rgba(237,233,224,0.55); padding: 6px 12px; border-radius: 6px;
      transition: color 0.2s var(--ease), background 0.2s var(--ease);
    }
    .nav-link:hover { color: #EDE9E0; background: rgba(255,255,255,0.06); }
    .nav-link.active { color: #EDE9E0; }

    .nav-cta {
      font-family: var(--font-sans); font-size: 13px; font-weight: 500;
      padding: 7px 16px; border-radius: 999px;
      border: 1px solid rgba(237,233,224,0.2);
      color: #EDE9E0;
      transition: all 0.25s var(--ease);
      display: inline-flex; align-items: center; gap: 6px;
      margin-left: 4px;
    }
    .nav-cta:hover { background: var(--accent); border-color: var(--accent); color: #1E1B15; }
    @media (max-width: 640px) { .nav-link { display: none; } }

    /* ── PAGE SHELL ──────────────────────────────────────────────── */
    .page {
      position: relative; z-index: 1;
      padding-top: 56px;
      max-width: var(--max-w);
      margin: 0 auto;
    }

    /* ── SITE HEADER ─────────────────────────────────────────────── */
    .site-header {
      padding: clamp(44px, 6vh, 72px) var(--pad-x) clamp(32px, 4vh, 52px);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: flex-start; justify-content: space-between;
      gap: 32px; flex-wrap: wrap;
    }

    .site-header-left { flex: 1; min-width: 220px; }

    .site-title {
      font-family: var(--font-serif);
      font-size: clamp(38px, 5.5vw, 68px);
      font-weight: 400; line-height: 1.0;
      letter-spacing: -0.025em; color: var(--fg);
      margin-bottom: 14px;
    }
    .site-title em { font-style: italic; color: var(--accent); }

    .site-desc {
      font-family: var(--font-sans); font-size: 15.5px;
      color: var(--fg-muted); line-height: 1.65;
      max-width: 480px;
    }

    .site-header-author {
      display: flex; align-items: center; gap: 14px;
      padding: 16px 20px;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 12px;
      flex-shrink: 0;
    }

    .author-avatar {
      width: 48px; height: 48px; border-radius: 50%;
      object-fit: cover; border: 2px solid var(--border-mid);
      flex-shrink: 0;
    }
    .author-avatar-fallback {
      width: 48px; height: 48px; border-radius: 50%;
      background: var(--accent); color: var(--bg);
      font-family: var(--font-serif); font-size: 20px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .author-info { display: flex; flex-direction: column; gap: 3px; }
    .author-name {
      font-family: var(--font-sans); font-size: 14px; font-weight: 600;
      color: var(--fg);
    }
    .author-role {
      font-family: var(--font-sans); font-size: 12.5px;
      color: var(--fg-muted); line-height: 1.5;
    }
    .author-bio {
      font-family: var(--font-sans); font-size: 11.5px;
      color: var(--fg-dim); line-height: 1.5; margin-top: 1px;
    }
    .author-profile-link {
      font-family: var(--font-sans); font-size: 12px; font-weight: 500;
      color: var(--accent); display: inline-flex; align-items: center; gap: 4px;
      margin-top: 5px;
    }
    .author-profile-link:hover { opacity: 0.75; }

    .site-topics {
      display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
      margin-top: 18px;
    }
    .site-topic-item {
      font-family: var(--font-sans); font-size: 12.5px; font-weight: 500;
      color: var(--fg-dim);
    }
    .site-topic-sep { color: var(--border-mid); font-size: 14px; }

    @media (max-width: 700px) {
      .site-header { flex-direction: column; }
      .site-header-author { width: 100%; }
    }

    /* ── BODY LAYOUT ─────────────────────────────────────────────── */
    .body-wrap {
      display: grid;
      grid-template-columns: var(--sidebar-w) 1fr;
      align-items: start;
      padding: 0 var(--pad-x);
    }
    @media (max-width: 860px) { .body-wrap { grid-template-columns: 1fr; } }

    /* ── SIDEBAR ─────────────────────────────────────────────────── */
    .sidebar {
      position: sticky; top: 72px;
      padding: 36px 28px 36px 0;
      border-right: 1px solid var(--border);
      min-height: calc(100vh - 72px);
    }
    @media (max-width: 860px) {
      .sidebar { position: static; border-right: none; border-bottom: 1px solid var(--border); padding: 28px 0; min-height: auto; }
    }

    .sidebar-section { margin-bottom: 32px; }
    .sidebar-section:last-child { margin-bottom: 0; }

    .sidebar-label {
      font-family: var(--font-mono); font-size: 10px; font-weight: 500;
      text-transform: uppercase; letter-spacing: 0.14em;
      color: var(--fg-dim); margin-bottom: 12px;
    }

    .topic-list { list-style: none; display: flex; flex-direction: column; gap: 2px; }
    .topic-list a {
      display: flex; align-items: center; justify-content: space-between;
      padding: 7px 10px; border-radius: 6px;
      font-family: var(--font-sans); font-size: 13.5px; color: var(--fg-muted);
      transition: background 0.15s, color 0.15s;
    }
    .topic-list a:hover, .topic-list a.active {
      background: var(--accent-dim); color: var(--accent);
    }
    .topic-count {
      font-family: var(--font-mono); font-size: 11px; color: var(--fg-dim);
    }

    .sidebar-links { display: flex; flex-direction: column; gap: 6px; }
    .sidebar-ext-link {
      display: inline-flex; align-items: center; gap: 9px;
      font-family: var(--font-sans); font-size: 13.5px; color: var(--fg-muted);
      padding: 5px 2px;
      transition: color 0.15s;
    }
    .sidebar-ext-link:hover { color: var(--accent); }
    .sidebar-ext-link svg { width: 15px; height: 15px; fill: currentColor; flex-shrink: 0; }

    /* ── FEED ────────────────────────────────────────────────────── */
    .feed { padding: 36px 0 56px 48px; }
    @media (max-width: 860px) { .feed { padding: 28px 0 48px; } }

    .feed-header {
      display: flex; align-items: baseline; justify-content: space-between;
      margin-bottom: 36px; padding-bottom: 14px;
      border-bottom: 1px solid var(--border);
    }
    .feed-label {
      font-family: var(--font-mono); font-size: 10.5px; font-weight: 500;
      text-transform: uppercase; letter-spacing: 0.14em; color: var(--fg-dim);
    }
    .feed-count {
      font-family: var(--font-sans); font-size: 12.5px; color: var(--fg-dim);
    }

    /* ── ARTICLE ENTRY ───────────────────────────────────────────── */
    .entry {
      padding: 28px 0;
      border-bottom: 1px solid var(--border);
      display: grid;
      grid-template-columns: 88px 1fr;
      gap: 0 28px;
    }
    .entry:first-child { padding-top: 0; }
    .entry:last-child  { border-bottom: none; }

    .entry-date-col { padding-top: 4px; }
    .entry-date {
      font-family: var(--font-mono); font-size: 11px;
      color: var(--fg-dim); letter-spacing: 0.04em; line-height: 1.5;
    }
    .entry-read-time {
      font-family: var(--font-mono); font-size: 10.5px;
      color: var(--fg-dim); margin-top: 4px;
    }

    .entry-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 9px; }
    .entry-tag {
      font-family: var(--font-mono); font-size: 9.5px; font-weight: 500;
      padding: 2px 8px; border-radius: 3px;
      color: var(--accent); text-transform: uppercase; letter-spacing: 0.08em;
      background: var(--accent-dim); border: 1px solid rgba(184,145,10,0.18);
      text-decoration: none; transition: background 0.15s;
    }
    .entry-tag:hover { background: rgba(184,145,10,0.20); }

    .entry-title {
      font-family: var(--font-serif); font-weight: 400;
      font-size: clamp(19px, 2.2vw, 26px); line-height: 1.25;
      letter-spacing: -0.01em; color: var(--fg);
      margin-bottom: 10px;
    }
    .entry-title a { transition: color 0.2s; }
    .entry-title a:hover { color: var(--accent); }

    .entry-excerpt {
      font-family: var(--font-sans); font-size: 14px; line-height: 1.7;
      color: var(--fg-muted); margin-bottom: 14px; max-width: 580px;
    }

    .entry-more {
      font-family: var(--font-sans); font-size: 13px; font-weight: 500;
      color: var(--accent); display: inline-flex; align-items: center; gap: 5px;
      transition: gap 0.2s var(--ease);
    }
    .entry-more:hover { gap: 9px; }

    /* Featured entry */
    .entry.featured {
      display: block;
      padding: 24px 22px;
      margin: 0 -22px 4px;
      border-radius: 10px;
      border: 1px solid rgba(184,145,10,0.20);
      background: linear-gradient(135deg, var(--accent-dim) 0%, rgba(184,145,10,0.04) 100%);
    }
    .featured-meta {
      display: flex; align-items: center; gap: 12px;
      margin-bottom: 10px;
    }
    .featured-badge {
      font-family: var(--font-mono); font-size: 9.5px; font-weight: 500;
      text-transform: uppercase; letter-spacing: 0.12em;
      padding: 3px 9px; border-radius: 999px;
      background: var(--accent); color: #fff;
    }
    .featured-date, .featured-read-time {
      font-family: var(--font-mono); font-size: 11px; color: var(--fg-dim);
    }

    @media (max-width: 540px) {
      .entry { grid-template-columns: 1fr; }
      .entry-date-col { display: flex; align-items: center; gap: 10px; padding-top: 0; }
      .entry-read-time { margin-top: 0; }
    }

    /* ── FOOTER ──────────────────────────────────────────────────── */
    .footer {
      border-top: 1px solid var(--border);
      padding: 28px var(--pad-x);
      margin-top: 0;
    }
    .footer-inner {
      max-width: var(--max-w); margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 12px;
      font-family: var(--font-sans); font-size: 12.5px; color: var(--fg-dim);
    }
    .footer-brand {
      display: flex; align-items: center; gap: 8px;
      font-weight: 500; color: var(--fg-muted);
    }
    .footer-brand .dot {
      width: 5px; height: 5px; border-radius: 50%;
      background: var(--accent); box-shadow: 0 0 6px var(--accent-glow);
    }
  </style>
</head>
<body>

  <nav class="nav" id="nav">
    <a href="/" class="nav-brand">
      <span class="dot"></span>
      harisankarsivankutty.in
    </a>
    <div class="nav-right">
      <a href="/about/" class="nav-link">about</a>
      <a href="https://topmate.io/harisankar_sivankutty" target="_blank" rel="noopener" class="nav-cta">
        Book a 1:1 ↗
      </a>
    </div>
  </nav>

  <div class="page">

    <!-- SITE HEADER -->
    <header class="site-header">
      <div class="site-header-left">
        <h1 class="site-title">Notes from the<br><em>data trenches.</em></h1>
        <p class="site-desc">
          Data engineering and AI engineering are still young disciplines — and the
          distance between a working prototype and something you'd trust in production
          is wider than most write-ups admit. I've spent over a decade at Thoughtworks
          working on data platforms and GenAI systems for enterprise clients, and I
          write here about what I find worth capturing: the trade-offs that tutorials
          skip, the failure modes that surface only at scale, and the patterns that
          actually hold up over time.
        </p>
        <div class="site-topics">
          <span class="site-topic-item">Data pipelines &amp; dbt</span>
          <span class="site-topic-sep">·</span>
          <span class="site-topic-item">GenAI &amp; RAG systems</span>
          <span class="site-topic-sep">·</span>
          <span class="site-topic-item">AWS / Azure / GCP</span>
          <span class="site-topic-sep">·</span>
          <span class="site-topic-item">System design</span>
        </div>
      </div>

      <div class="site-header-author">
        <img src="/images/hari.jpg" alt="Harisankar Sivankutty" class="author-avatar"
             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
        <div class="author-avatar-fallback" style="display:none;" aria-hidden="true">H</div>
        <div class="author-info">
          <span class="author-name">Harisankar Sivankutty</span>
          <span class="author-role">Senior Consultant · Thoughtworks<br>Data &amp; AI Engineering</span>
          <span class="author-bio">AWS Solutions Architect · RHCE<br>10+ yrs · India</span>
          <a href="/about/" class="author-profile-link">Full profile →</a>
        </div>
      </div>
    </header>

    <div class="body-wrap">

      <!-- SIDEBAR -->
      <aside class="sidebar">

        <div class="sidebar-section">
          <div class="sidebar-label">Topics</div>
          <ul class="topic-list" id="topic-list">
            <li>
              <a href="#" class="active" data-tag="all">
                All <span class="topic-count">{{ collections.posts | length }}</span>
              </a>
            </li>
            {% set tagCountMap = collections.posts | tagCounts %}
            {% for tagName, count in tagCountMap %}
            <li>
              <a href="#" data-tag="{{ tagName | lower | replace(' ', '-') }}">
                {{ tagName }} <span class="topic-count">{{ count }}</span>
              </a>
            </li>
            {% endfor %}
          </ul>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-label">Links</div>
          <div class="sidebar-links">
            <a href="/about/" class="sidebar-ext-link">
              <svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
              Profile
            </a>
            <a href="https://www.linkedin.com/in/harisankarsivankutty/" target="_blank" rel="noopener" class="sidebar-ext-link">
              <svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
            <a href="https://medium.com/@brainbytebyhari" target="_blank" rel="noopener" class="sidebar-ext-link">
              <svg viewBox="0 0 24 24"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
              Medium
            </a>
            <a href="https://topmate.io/harisankar_sivankutty" target="_blank" rel="noopener" class="sidebar-ext-link">
              <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
              Book a 1:1
            </a>
          </div>
        </div>

      </aside>

      <!-- FEED -->
      <main class="feed">

        <div class="feed-header">
          <span class="feed-label">Latest</span>
          <span class="feed-count" id="feed-count">{{ collections.posts | length }} post{{ 's' if collections.posts | length != 1 else '' }}</span>
        </div>

        {% for post in collections.posts %}
          {% set postTags = post.data.tags %}
          {% set tagStr = postTags | join(",") | lower | replace(" ", "-") %}

          {% if loop.first %}
          <article class="entry featured" data-tags="{{ tagStr }}">
            <div class="featured-meta">
              <span class="featured-badge">Latest</span>
              <span class="featured-date">{{ post.date | postDate }}</span>
              <span class="featured-read-time">· {{ post.templateContent | readTime }} min read</span>
            </div>
            <div class="entry-tags">
              {% for tag in postTags %}
                <a href="/tags/{{ tag | slugify }}/" class="entry-tag">{{ tag }}</a>
              {% endfor %}
            </div>
            <h2 class="entry-title">
              <a href="{{ post.url }}">{{ post.data.title }}</a>
            </h2>
            {% if post.data.excerpt %}
            <p class="entry-excerpt">{{ post.data.excerpt }}</p>
            {% endif %}
            <a href="{{ post.url }}" class="entry-more">Read article <span>→</span></a>
          </article>

          {% else %}
          <article class="entry" data-tags="{{ tagStr }}">
            <div class="entry-date-col">
              <div class="entry-date">{{ post.date | postDate }}</div>
              <div class="entry-read-time">{{ post.templateContent | readTime }} min</div>
            </div>
            <div>
              <div class="entry-tags">
                {% for tag in postTags %}
                  <a href="/tags/{{ tag | slugify }}/" class="entry-tag">{{ tag }}</a>
                {% endfor %}
              </div>
              <h2 class="entry-title">
                <a href="{{ post.url }}">{{ post.data.title }}</a>
              </h2>
              {% if post.data.excerpt %}
              <p class="entry-excerpt">{{ post.data.excerpt }}</p>
              {% endif %}
              <a href="{{ post.url }}" class="entry-more">Read article <span>→</span></a>
            </div>
          </article>
          {% endif %}

        {% else %}
          <p style="font-family:var(--font-sans);font-size:15px;color:var(--fg-muted);padding:24px 0;">
            First article coming soon.
          </p>
        {% endfor %}

      </main>

    </div>

  </div>

  <footer class="footer">
    <div class="footer-inner">
      <span class="footer-brand">
        <span class="dot"></span>
        harisankarsivankutty.in
      </span>
      <span>© 2026 Harisankar Sivankutty · Senior Consultant, Thoughtworks</span>
    </div>
  </footer>

  <script>
    const nav = document.getElementById('nav');
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 20);
    }, { passive: true });

    document.querySelectorAll('#topic-list a').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        document.querySelectorAll('#topic-list a').forEach(l => l.classList.remove('active'));
        link.classList.add('active');
        const tag = link.dataset.tag;
        let visible = 0;
        document.querySelectorAll('.entry').forEach((entry) => {
          const tags = (entry.dataset.tags || '').split(',');
          const show = tag === 'all' || tags.includes(tag);
          entry.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        document.getElementById('feed-count').textContent =
          visible + ' post' + (visible !== 1 ? 's' : '');
      });
    });
  </script>

</body>
</html>
