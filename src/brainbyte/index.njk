---
layout: brainbyte.njk
title: "Claude practice packs & production starter kits"
pageTitle: "Free Claude Certification Practice & Starter Kits | BrainByte"
description: "285 free practice questions for the Claude Certified Architect exams, plus tested starter kits for data and AI engineers. Built by an architect with 10+ years in production."
permalink: /brainbyte/index.html
eleventyExcludeFromCollections: true
---
{#- Marketing order: what you can buy today → try before you buy → what's coming → 1:1 help → stay in touch.
    All content comes from src/_data/brainbyte.json. -#}

<!-- 1. HERO -->
<section class="bb-hero">
  <img class="bb-hero-photo" src="/images/profile/hari_new.png" alt="Harisankar Sivankutty" width="140" height="140" />
  <h1 class="bb-h1">Pass your Claude exam.<br>Ship <span class="bb-hl">production-grade</span> code.</h1>
  <p class="bb-lede"><strong>Free</strong> practice question banks for the <strong>Claude Certified Architect</strong> exams, and tested starter kits for data and AI engineers, from an architect who builds these systems for enterprise clients.</p>
  <div class="bb-hero-ctas">
    <a href="#claude" class="bb-btn bb-btn-primary">Get the free practice packs</a>
    <a href="#kits" class="bb-btn bb-btn-secondary">See the starter kits</a>
  </div>
  {% include "bb-connect.njk" %}
</section>

<!-- 2. CLAUDE EXAM PREP: per exam, the free study guide + the practice pack (exams.json) -->
<section class="bb-band" id="claude">
  <div class="bb-wrap">
    <span class="bb-kicker">Free · Available now</span>
    <h2 class="bb-h2">Claude certification prep</h2>
    <p class="bb-sub">For each exam: a study guide that shows how the exam thinks, and a practice question bank to test yourself. Written by someone who passed CCAR-F and CCAR-P.</p>
    <div class="ep-grid">
      {%- for exam in exams %}{% set epStyle = "bb" %}{% include "exam-prep-card.njk" %}{% endfor %}
    </div>
    <p class="bb-disclaimer">Independent study material, not affiliated with or endorsed by Anthropic. Contains no actual exam questions.</p>
  </div>
</section>

<!-- 3. FREE SAMPLE (try before you buy) -->
<section class="bb-section" id="practice">
  <div class="bb-wrap bb-wrap-narrow">
    <h2 class="bb-h2">Try a free question</h2>
    <p class="bb-sub">See the style: a real-world scenario, four options, and the reasoning behind the answer.</p>
    <div class="bb-byte" data-bb-quiz data-bb-track="claude-architect">
      <div class="bb-byte-body" data-bb-body aria-live="polite"></div>
      <noscript><p class="bb-byte-q">Turn on JavaScript to try the practice questions.</p></noscript>
    </div>
    <p class="bb-after-quiz">Want 285 more like this? <a class="bb-text-link" href="#claude">Get the free practice packs →</a></p>
  </div>
</section>

<!-- 4. STARTER KITS / GITHUB CODE (coming soon) -->
<section class="bb-band" id="kits">
  <div class="bb-wrap">
    <span class="bb-kicker">First kit free · more coming</span>
    <h2 class="bb-h2">Production starter kits</h2>
    <p class="bb-sub">Code from real enterprise projects, cleaned up and packaged so you can start from something that already works in production.</p>

    <ul class="bb-promise">
      {% for pr in brainbyte.kitPromise %}
      <li><span class="bb-promise-check" aria-hidden="true">✓</span><strong>{{ pr.title }}</strong><span>{{ pr.text }}</span></li>
      {% endfor %}
    </ul>

    <div class="bb-kits">
      {% for k in brainbyte.kits %}
      {%- set kitPost = (collections.posts | postsBySlugs([k.post]))[0] if k.post else null -%}
      <article class="bb-kit">
        <div class="bb-kit-head">
          <svg class="bb-kit-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.4-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.6.3 2.8.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5z"/></svg>
          <span class="bb-badge{{ ' bb-badge-live' if k.status == 'live' else '' }}">{{ ('Free · ' if k.free else '') + 'Available now' if k.status == 'live' else 'Coming soon' }}</span>
        </div>
        <h3 class="bb-kit-title">{{ k.title }}</h3>
        <p class="bb-kit-blurb">{{ k.blurb }}</p>
        <ul class="bb-kit-stack">{% for st in k.stack %}<li>{{ st }}</li>{% endfor %}</ul>
        <div class="bb-kit-foot">
          {% if k.status == 'live' and k.url %}
          <a class="bb-btn bb-btn-primary bb-btn-sm" href="{{ k.url }}" target="_blank" rel="noopener">{{ 'Get it free' if k.free else 'Get the code' }} ↗</a>
          {% else %}
          <a class="bb-text-link" href="#newsletter">Tell me when it's ready →</a>
          {% endif %}
          {% if kitPost %}<a class="bb-kit-read" href="{{ site.url }}{{ kitPost.url }}">Read the story behind it ↗</a>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- 5. MORE GUIDES ON THE WAY (brainbyte.json `tracks` without a live guide) -->
<section class="bb-section" id="tracks">
  <div class="bb-wrap">
    <span class="bb-kicker">Coming soon</span>
    <h2 class="bb-h2">More guides on the way</h2>
    <p class="bb-sub">Step-by-step guides from real projects: Google Cloud, production data engineering and Databricks. Subscribe to hear when each one opens.</p>
    <div class="bb-track-grid">
      {%- set liveTrackSlugs = [] %}{% for g in bbLiveGuides %}{% set liveTrackSlugs = (liveTrackSlugs.push(g.track), liveTrackSlugs) %}{% endfor %}
      {% for t in brainbyte.tracks %}{% if t.slug not in liveTrackSlugs %}
      {% if t.status == 'live' %}
      <a href="{{ ('/tracks/' + t.slug + '/') | bb }}" class="bb-track" style="--track: {{ t.color }}" data-bb-track-card="{{ t.slug }}" data-bb-modules="{{ t.modules.length }}">
      {% else %}
      <div class="bb-track is-soon" style="--track: {{ t.color }}">
      {% endif %}
        <div class="bb-track-row">
          <span class="bb-track-logo"><img src="{{ t.logo }}" alt="" width="36" height="36" loading="lazy" /></span>
          {% if t.status != 'live' %}<span class="bb-badge">Coming soon</span>{% endif %}
        </div>
        <h3 class="bb-track-title">{{ t.title }}</h3>
        <p class="bb-track-meta">{{ t.modules.length }} modules · {{ t.level }}</p>
        {% if t.status == 'live' %}
        <div class="bb-progress" aria-hidden="true"><span data-bb-bar></span></div>
        <span class="bb-track-go"><span data-bb-progress-label>Start the guide</span> →</span>
      </a>
        {% else %}
      </div>
        {% endif %}
      {% endif %}{% endfor %}
    </div>
  </div>
</section>

<!-- 6. 1:1 COACHING (live) -->
<section class="bb-band" id="coaching">
  <div class="bb-wrap">
    <span class="bb-kicker">Available now</span>
    <h2 class="bb-h2">1:1 help</h2>
    <p class="bb-sub">Book time with me on Topmate.</p>
    <div class="bb-shelf bb-shelf-2">
      {% for c in brainbyte.coaching %}
      <article class="bb-product is-live">
        <h3 class="bb-product-title">{{ c.title }}</h3>
        <p class="bb-product-blurb">{{ c.blurb }}</p>
        <a class="bb-btn bb-btn-primary bb-btn-sm" href="{{ c.url }}" target="_blank" rel="noopener">{% include "topmate-icon.njk" %}Book on Topmate ↗</a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- 7. NEWSLETTER -->
<section class="bb-section" id="newsletter">
  <div class="bb-wrap bb-wrap-narrow">
    {% set newsId = 'home' %}{% include "bb-newsletter.njk" %}
  </div>
</section>

<script type="application/json" id="bb-data">{{ { "bytes": brainbyte.bytes, "tracks": brainbyte.tracks, "base": ("/" | bb) } | dump | safe }}</script>
