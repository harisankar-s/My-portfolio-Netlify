{#- Glossy "3D" icon tiles (.ico3d): one glyph per name. Import with
    {% from "ico.njk" import ico %} (hub, /for/ pages). -#}
{%- macro ico(name) -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{%- if name == "mail" %}<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 7l8 6 8-6"/>
{%- elif name == "course" %}<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/><path d="M22 9v6"/>
{%- elif name == "check" %}<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>
{%- elif name == "db" %}<ellipse cx="12" cy="5.5" rx="7.5" ry="2.8"/><path d="M4.5 5.5v6.2c0 1.6 3.4 2.8 7.5 2.8s7.5-1.2 7.5-2.8V5.5"/><path d="M4.5 11.7v6.2c0 1.6 3.4 2.8 7.5 2.8s7.5-1.2 7.5-2.8v-6.2"/>
{%- elif name == "code" %}<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/>
{%- elif name == "spark" %}<path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8"/>
{%- elif name == "play" %}<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M10 9l5 3-5 3z"/>
{%- elif name == "users" %}<circle cx="9" cy="8" r="3.2"/><path d="M3 19c.6-3.2 3-5 6-5s5.4 1.8 6 5"/><circle cx="17" cy="9" r="2.4"/><path d="M15.5 14.2c2.6.2 4.6 1.8 5.5 4.8"/>
{%- endif %}</svg>
{%- endmacro %}
