{#- The one site footer, used on every page (after charliehills.ai): name, a
    one-line description, every link, then privacy policy + copyright. Styles in
    /assets/site-chrome.css. One domain, so every link is relative. -#}
{%- set nl = site.newsletter -%}
<footer class="site-footer">
  <div class="sf-inner">
    <div class="sf-brand">
      <a href="/" class="sf-name">{{ profile.name }}</a>
      <p class="sf-sub">Data and AI architect. I write {{ nl.name }}, practical AI you can actually use, plus free exam guides, resources and starter kits.</p>
    </div>
    <nav class="sf-links" aria-label="Footer">
      <a href="/">Home</a>
      <a href="/about/">About</a>
      <a href="/blog/">Articles</a>
      <a href="/guides/">Exam guides</a>
      <a href="/resources/">Free resources</a>
      <a href="/newsletter/">Newsletter</a>
      <a href="/kits/">Starter kits</a>
      <a href="/ask/">AskHari.ai</a>
      <a href="{% if nl.username %}https://{{ nl.username }}.substack.com/{% else %}/#join{% endif %}">Subscribe</a>
    </nav>
    {%- set c = profile.contact %}
    <div class="sf-social" aria-label="Find me elsewhere">
      {%- if c.github %}<a href="{{ c.github }}" target="_blank" rel="noopener" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"/></svg>GitHub</a>{% endif %}
      {%- if c.medium %}<a href="{{ c.medium }}" target="_blank" rel="noopener" aria-label="Medium"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 6.77-6.82A6.8 6.8 0 0 1 13.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>Medium</a>{% endif %}
      {%- if nl.username %}<a href="https://{{ nl.username }}.substack.com/" target="_blank" rel="noopener" aria-label="Substack"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 3h18v2.6H3zm0 5h18v2.6H3zm0 5h18v8l-9-5-9 5z"/></svg>Substack</a>{% endif %}
      {%- if site.topmateUrl %}<a href="{{ site.topmateUrl }}" target="_blank" rel="noopener" aria-label="Book a 1:1 on Topmate">{% include "topmate-icon.njk" %}Book a 1:1</a>{% endif %}
      {%- if c.linkedin %}<a href="{{ c.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>LinkedIn</a>{% endif %}
    </div>
    <div class="sf-bottom">
      <a href="/privacy/">Privacy policy</a>
      <span>© 2026 Harisankar S.</span>
    </div>
  </div>
</footer>
