<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="author" content="{{ site.author }}" />
  <script>
    (function () {
      document.documentElement.classList.add('bb-js');
      try {
        var saved = localStorage.getItem('theme');
        var theme = saved === 'light' || saved === 'dark'
          ? saved
          : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>
  {% set bbDesc = description or 'BrainByte: Claude certification practice packs and production starter kits by Harisankar Sivankutty.' %}
  <meta name="description" content="{{ bbDesc }}" />
  <meta property="og:title" content="{{ title }} — BrainByte" />
  <meta property="og:description" content="{{ bbDesc }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ site.brainbyteUrl }}{{ page.url | bbPublicPath }}" />
  <title>{{ title }} — BrainByte</title>
  <link rel="canonical" href="{{ site.brainbyteUrl }}{{ page.url | bbPublicPath }}" />
  <link rel="icon" href="/images/favicon.png" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,400&display=swap" rel="stylesheet" />

  <!-- BrainByte has its own tokens (layouts in this repo don't share CSS).
       Lato throughout, large type, one idea per section. -->
  <style>
    :root {
      --bg: #FFFFFF;
      --band: #F6F7F9;
      --card: #FFFFFF;
      --border: #E5E7EB;
      --border-strong: #D1D5DB;
      --fg: #1F2937;
      --fg-muted: #4B5563;
      --fg-dim: #6B7280;
      --pop: #0071E3;
      --pop-ink: #0066CC;
      --pop-soft: #E8F1FD;
      --brand: #0066CC;
      --brand-soft: #E8F1FD;
      --link: #0066CC;
      --ok: #059669;
      --ok-soft: #D1FAE5;
      --bad: #DC2626;
      --bad-soft: #FEE2E2;
      --font: 'Lato', system-ui, -apple-system, 'Segoe UI', sans-serif;
      --max-w: 1120px;
      --pad-x: clamp(16px, 4vw, 40px);
      --ease: cubic-bezier(0.22, 1, 0.36, 1);
    }
    :root[data-theme="dark"] {
      --bg: #0F1217;
      --band: #161A21;
      --card: #1B2028;
      --border: #2A303A;
      --border-strong: #3A414D;
      --fg: #F3F4F6;
      --fg-muted: #C3C8D0;
      --fg-dim: #9AA1AC;
      --pop-ink: #2997FF;
      --pop-soft: rgba(0, 113, 227, 0.16);
      --brand: #2997FF;
      --brand-soft: rgba(0, 113, 227, 0.16);
      --link: #2997FF;
      --ok: #34D399;
      --ok-soft: rgba(52, 211, 153, 0.14);
      --bad: #F87171;
      --bad-soft: rgba(248, 113, 113, 0.14);
    }
    body { background: var(--bg); color: var(--fg); }
  </style>
  <link rel="stylesheet" href="/assets/brainbyte.css" />
</head>
<body class="bb">

  <nav class="bb-nav" id="nav">
    <a href="{{ '/' | bb }}" class="bb-logo" aria-label="BrainByte home">
      <span class="bb-logo-mark" aria-hidden="true">B</span>
      <span>Brain<span class="bb-logo-pop">Byte</span></span>
    </a>
    <div class="bb-nav-right">
      <ul class="bb-nav-links">
        <li><a href="{{ '/' | bb }}#claude">Claude packs</a></li>
        <li><a href="{{ '/' | bb }}#kits">Starter kits</a></li>
        <li><a href="{{ '/' | bb }}#coaching">1:1 help</a></li>
      </ul>
      <span class="bb-xp" data-bb-xp title="Practice questions you've answered correctly on this device" hidden>
        ★ <span data-bb-xp-count>0</span>
      </span>
      <button type="button" class="bb-theme" data-theme-toggle aria-label="Toggle color theme">
        <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><line x1="12" y1="2" x2="12" y2="4"></line><line x1="12" y1="20" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="6.34" y2="6.34"></line><line x1="17.66" y1="17.66" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="4" y2="12"></line><line x1="20" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="6.34" y2="17.66"></line><line x1="17.66" y1="6.34" x2="19.07" y2="4.93"></line></svg>
        <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </button>
    </div>
  </nav>

  <main class="bb-main">
    {{ content | safe }}
  </main>

  <footer class="bb-footer">
    <div class="bb-footer-inner">
      {% include "bb-connect.njk" %}
      <p class="bb-footer-note">
        BrainByte by <a href="{{ site.portfolioUrl }}/">Harisankar Sivankutty</a> ·
        <a href="{{ site.url }}/">Blog</a> ·
        <a href="{{ site.portfolioUrl }}/about/">About</a>
      </p>
      <p class="bb-footer-fine">Practice questions are original and are not real exam questions.</p>
    </div>
  </footer>

  <script>
    (function () {
      var nav = document.getElementById('nav');
      window.addEventListener('scroll', function () {
        nav.classList.toggle('scrolled', window.scrollY > 12);
      }, { passive: true });
    })();
  </script>
  <script src="/assets/brainbyte.js" defer></script>
  <link rel="stylesheet" href="/assets/ask-hari-widget.css">
  <script src="/assets/ask-hari-widget.js" defer></script>
  <script src="/assets/theme-toggle.js" defer></script>
</body>
</html>
