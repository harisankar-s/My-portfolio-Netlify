<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="author" content="Harisankar Sivankutty" />
  <meta name="theme-color" content="#F9F8F4" />
  <meta name="description" content="{{ subtitle or description or 'Writing by Harisankar Sivankutty.' }}" />
  <meta property="og:title" content="{{ title }} — Harisankar Sivankutty" />
  <meta property="og:description" content="{{ subtitle or description or '' }}" />
  <meta property="og:type" content="article" />
  <title>{{ title }} — Harisankar Sivankutty</title>
  <link rel="canonical" href="{{ canonicalUrl or (site.url + page.url) }}" />
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ site.url }}/feed.xml" />
  <link rel="icon" href="/images/favicon.png" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600&family=Lora:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #F9F8F4; --bg-elevated: #F0EEE6; --surface: #E8E6DC;
      --border: rgba(0,0,0,0.08); --border-strong: rgba(0,0,0,0.16);
      --fg: #1A1A18; --fg-muted: #3E3E38; --fg-dim: #8A8A80;
      --accent: #B8910A; --accent-dim: rgba(184,145,10,0.10); --accent-glow: rgba(184,145,10,0.22);
      --font-sans:    'Inter', system-ui, sans-serif;
      --font-article: 'Lora', 'Georgia', serif;
      --font-serif: 'Instrument Serif', 'Georgia', serif;
      --font-mono:  'JetBrains Mono', ui-monospace, monospace;
      --max-w: 1280px; --content-w: 680px;
      --pad-x: clamp(20px, 4vw, 56px); --ease: cubic-bezier(0.22, 1, 0.36, 1);
    }

    html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }

    body {
      background: var(--bg); color: var(--fg);
      font-family: var(--font-sans); font-size: 15px; line-height: 1.6;
      overflow-x: hidden; min-height: 100vh;
    }

    body::before {
      content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 1;
      opacity: 0.04; mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    }

    a { color: inherit; text-decoration: none; transition: color 0.3s var(--ease); }
    img { display: block; max-width: 100%; }
    ::selection { background: var(--accent); color: var(--bg); }

    /* NAV */
    .nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      padding: 18px var(--pad-x);
      display: flex; align-items: center; justify-content: space-between;
      background: #1C1814; border-bottom: 1px solid rgba(255,255,255,0.06);
      transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
    }
    .nav.scrolled { border-bottom-color: rgba(255,255,255,0.10); background: rgba(24,21,16,0.98); }
    .nav-brand { font-family: var(--font-mono); font-size: 13px; font-weight: 500; letter-spacing: -0.01em; color: #EDE9E0; display: flex; align-items: center; gap: 10px; }
    .nav-brand .dot { width: 7px; height: 7px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 10px var(--accent-glow); animation: pulse 2.6s ease-in-out infinite; }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.45;transform:scale(0.8)} }
    .nav-right { display: flex; align-items: center; gap: 6px; }
    .nav-link { font-family: var(--font-sans); font-size: 13.5px; font-weight: 500; color: rgba(237,233,224,0.55); padding: 6px 12px; border-radius: 6px; transition: color 0.2s, background 0.2s; }
    .nav-link:hover { color: #EDE9E0; background: rgba(255,255,255,0.06); }
    .nav-cta { font-family: var(--font-sans); font-size: 13px; font-weight: 500; padding: 7px 16px; border: 1px solid rgba(237,233,224,0.2); border-radius: 999px; color: #EDE9E0; transition: all 0.25s var(--ease); display: inline-flex; align-items: center; gap: 6px; margin-left: 4px; }
    .nav-cta:hover { background: var(--accent); border-color: var(--accent); color: #1E1B15; }
    @media (max-width: 640px) { .nav-link { display: none; } }

    /* LAYOUT */
    main { position: relative; z-index: 2; padding-top: 70px; }

    /* ARTICLE HEADER */
    .article-header {
      padding: clamp(56px,8vh,100px) var(--pad-x) clamp(40px,5vh,64px);
      max-width: calc(var(--content-w) + var(--pad-x) * 2); margin: 0 auto;
    }
    .breadcrumb { font-family: var(--font-mono); font-size: 11px; color: var(--fg-dim); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 36px; display: flex; align-items: center; gap: 8px; }
    .breadcrumb a:hover { color: var(--accent); }
    .breadcrumb-sep { color: var(--border-strong); }
    .article-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
    .article-tag { font-family: var(--font-mono); font-size: 10.5px; padding: 4px 12px; border: 1px solid var(--border); border-radius: 4px; color: var(--accent); text-transform: uppercase; letter-spacing: 0.1em; background: var(--accent-dim); }
    .article-title { font-family: var(--font-serif); font-weight: 400; font-size: clamp(32px,5vw,56px); line-height: 1.1; letter-spacing: -0.02em; color: var(--fg); margin-bottom: 24px; }
    .article-subtitle { font-family: var(--font-sans); font-size: 17px; line-height: 1.65; color: var(--fg-muted); margin-bottom: 36px; max-width: 560px; }
    .article-byline { display: flex; align-items: center; gap: 14px; padding-top: 24px; border-top: 1px solid var(--border); }
    .byline-avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border); }
    .byline-avatar-placeholder { width: 40px; height: 40px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; font-family: var(--font-serif); font-size: 18px; color: var(--bg); flex-shrink: 0; }
    .byline-info { display: flex; flex-direction: column; gap: 2px; }
    .byline-name { font-family: var(--font-sans); font-size: 13.5px; font-weight: 600; color: var(--fg); }
    .byline-meta { font-family: var(--font-sans); font-size: 12px; color: var(--fg-dim); }

    /* ARTICLE BODY */
    .article-body { padding: 0 var(--pad-x) clamp(64px,10vh,120px); max-width: calc(var(--content-w) + var(--pad-x) * 2); margin: 0 auto; }
    .article-body p { font-family: var(--font-article); font-size: 18px; line-height: 1.85; color: var(--fg-muted); margin-bottom: 26px; }
    .article-body p:first-child { font-size: 19px; color: var(--fg); font-weight: 400; }
    .article-body h2 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(22px,3vw,34px); letter-spacing: -0.015em; color: var(--fg); margin-top: 60px; margin-bottom: 20px; line-height: 1.15; }
    .article-body h3 { font-family: var(--font-sans); font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); margin-top: 40px; margin-bottom: 14px; }
    .article-body ul, .article-body ol { padding-left: 24px; margin-bottom: 26px; }
    .article-body li { font-family: var(--font-article); font-size: 18px; line-height: 1.8; color: var(--fg-muted); margin-bottom: 8px; }
    .article-body ul li::marker { color: var(--accent); }
    .article-body strong { color: var(--fg); font-weight: 700; }
    .article-body em { font-style: italic; }
    .article-body a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
    .article-body a:hover { opacity: 0.75; }
    .article-body blockquote { margin: 36px 0; padding: 22px 28px; border-left: 3px solid var(--accent); background: var(--accent-dim); border-radius: 0 8px 8px 0; }
    .article-body blockquote p { font-family: var(--font-article); font-size: 20px; font-style: italic; color: var(--fg); margin: 0; line-height: 1.55; }
    .article-body code { font-family: var(--font-mono); font-size: 13px; background: var(--surface); border: 1px solid var(--border); padding: 2px 7px; border-radius: 4px; color: var(--fg); }
    .article-body pre { background: #1C1814; border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 24px; overflow-x: auto; margin: 28px 0; }
    .article-body pre code { background: transparent; border: none; padding: 0; font-size: 13px; color: #F0EDE4; line-height: 1.7; }
    .article-body hr { border: none; border-top: 1px solid var(--border); margin: 48px 0; }
    .article-body img { border-radius: 8px; margin: 32px 0; border: 1px solid var(--border); max-width: 100%; }
    .article-body figure { margin: 32px 0; }
    .article-body figcaption { font-family: var(--font-mono); font-size: 11.5px; color: var(--fg-dim); text-align: center; margin-top: 10px; }

    /* Mermaid diagrams */
    .article-body .mermaid { margin: 32px 0; text-align: center; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 8px; padding: 24px; overflow-x: auto; }

    /* Callout boxes */
    .callout { margin: 28px 0; padding: 20px 24px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-elevated); }
    .callout-title { font-family: var(--font-mono); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); margin-bottom: 10px; }
    .callout p { font-size: 13.5px !important; margin: 0 !important; }

    /* ARTICLE FOOTER */
    .article-footer { padding: 40px var(--pad-x) 80px; max-width: calc(var(--content-w) + var(--pad-x) * 2); margin: 0 auto; border-top: 1px solid var(--border); }
    .back-link { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 12.5px; color: var(--fg-muted); transition: color 0.3s var(--ease), gap 0.3s var(--ease); }
    .back-link:hover { color: var(--accent); gap: 12px; }

    /* FOOTER */
    .footer { border-top: 1px solid var(--border); padding: 32px var(--pad-x); }
    .footer-inner { max-width: var(--max-w); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; font-family: var(--font-mono); font-size: 11.5px; color: var(--fg-muted); }
    .footer-left { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .footer-brand { display: flex; align-items: center; gap: 8px; color: var(--fg); }
    .footer-brand .dot { width: 6px; height: 6px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 8px var(--accent-glow); }
    .footer-year { color: var(--fg-dim); }
    .footer-right { color: var(--fg-dim); font-size: 11px; }
  </style>
</head>
<body>

  <nav class="nav" id="nav">
    <a href="/" class="nav-brand">
      <span class="dot"></span>
      harisankarsivankutty.in
    </a>
    <div class="nav-right">
      <a href="/about/" class="nav-link">about</a>
      <a href="https://topmate.io/harisankar_sivankutty" target="_blank" rel="noopener" class="nav-cta">
        Book a 1:1 ↗
      </a>
    </div>
  </nav>

  <main>

    <header class="article-header">
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href="/">home</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/blog/">writing</a>
        <span class="breadcrumb-sep">/</span>
        <span>{{ page.fileSlug }}</span>
      </nav>

      {% if tags %}
      <div class="article-tags">
        {% for tag in tags %}
          <span class="article-tag">{{ tag }}</span>
        {% endfor %}
      </div>
      {% endif %}

      <h1 class="article-title">{{ title }}</h1>

      {% if subtitle %}
      <p class="article-subtitle">{{ subtitle }}</p>
      {% endif %}

      <div class="article-byline">
        <img src="/images/hari.jpg" alt="Harisankar Sivankutty" class="byline-avatar"
             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
        <div class="byline-avatar-placeholder" style="display:none;" aria-hidden="true">H</div>
        <div class="byline-info">
          <span class="byline-name">Harisankar Sivankutty</span>
          <span class="byline-meta">{{ date | postDate }} · {{ content | readTime }} min read</span>
        </div>
      </div>
    </header>

    <article class="article-body">
      {{ content | safe }}
    </article>

    <div class="article-footer">
      <a href="/blog/" class="back-link">
        <span>←</span> Back to writing
      </a>
    </div>

  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-left">
        <span class="footer-brand">
          <span class="dot"></span>
          harisankarsivankutty.in
        </span>
        <span class="footer-year">© 2026 · All rights reserved</span>
      </div>
      <div class="footer-right">Harisankar Sivankutty · Senior Consultant, Thoughtworks</div>
    </div>
  </footer>

  <script>
    const nav = document.getElementById('nav');
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 20);
    }, { passive: true });
  </script>

  <script type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
    mermaid.initialize({ startOnLoad: false, theme: 'neutral' });
    document.querySelectorAll('pre code.language-mermaid, code.language-mermaid').forEach((el) => {
      const div = document.createElement('div');
      div.className = 'mermaid';
      div.textContent = el.textContent;
      (el.closest('pre') || el).replaceWith(div);
    });
    await mermaid.run();
  </script>

</body>
</html>
