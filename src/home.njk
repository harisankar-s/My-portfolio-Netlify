---
permalink: /index.html
eleventyExcludeFromCollections: true
---
{#-
  Hub ("front door") at harisankarsivankutty.in/. Everything (hub, CV, blog,
  guides) lives on this one domain; the blog listing is /blog/. Its job is to grow BrainByte (the
  newsletter, on Substack) and BrainByte (practice packs, starter kits);
  Hari's own profile stays short here and lives in full at /about/.
  Calm, editorial dark look (Space Grotesk headings, Inter body, JetBrains
  Mono labels, soft blue accent used sparingly) over the 3D galaxy sky.
  All copy comes from data: site.json (newsletter), brainbyte.json,
  portfolio.json, profile.json and collections.posts. Styles: .hub-* in
  /assets/portfolio.css. Signup form: _includes/newsletter-form.njk.
-#}
{%- set p = profile -%}

{%- set latest = collections.posts[0] -%}
{%- set livePacks = [] -%}
{%- set questions = 0 -%}
{%- for pack in brainbyte.practice -%}{%- if pack.status == "live" -%}{%- set livePacks = (livePacks.push(pack), livePacks) -%}{%- set questions = questions + pack.count -%}{%- endif -%}{%- endfor -%}
{%- set nl = site.newsletter -%}
{%- from "ico.njk" import ico -%}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{ nl.tagline }}: free lessons on {{ nl.topics }}, a new issue {{ nl.cadence }} on Substack. Get {{ questions }} free Claude certification practice questions and free study guides." />
  <meta name="author" content="{{ p.name }}" />
  <meta property="og:title" content="{{ p.name }} | {{ nl.name }}, the Practical AI Newsletter" />
  <meta property="og:description" content="{{ nl.tagline }}: free lessons on {{ nl.topics }}, a new issue {{ nl.cadence }}. Get {{ questions }} free Claude certification practice questions and free study guides." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ site.portfolioUrl }}/" />
  <title>{{ p.name }} | {{ nl.name }}, the Practical AI Newsletter</title>
  <link rel="canonical" href="/" />
  <link rel="icon" href="/images/favicon-hari-32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/images/favicon-hari-192.png" sizes="192x192" type="image/png" />
  <link rel="apple-touch-icon" href="/images/apple-touch-icon-hari.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/portfolio.css" />
  <link rel="stylesheet" href="/assets/site-chrome.css" />
</head>
<body class="hub">

  <div class="pf-progress" id="progress" aria-hidden="true"></div>

  <!-- Fixed sky behind the whole page: a 3D galaxy + nebula in WebGL
       (galaxy.js) with golden comets on top (space.js, which also draws a
       plain starfield if WebGL isn't available). -->
  <div class="hub-sky" aria-hidden="true">
    <canvas class="sky-canvas" data-galaxy></canvas>
    <canvas class="sky-canvas" data-sky></canvas>
    <div class="sky-shade"></div>
  </div>

  {% set hubNavBase = "" %}{% include "hub-nav.njk" %}

  <main id="top">

    <!-- 1. HERO: the newsletter pitch + signup; the 3D galaxy fills the right. -->
    <section class="hub-hero" id="hero">
      <div class="hub-hero-inner">
        <div class="hub-hero-text">
          <p class="hub-label">{{ nl.name }} · Free newsletter</p>
          <h1 class="hub-hero-title">Practical AI you can <span class="hub-accent">actually use.</span></h1>
          <p class="hub-hero-lede">Plain-English AI lessons, free exam guides and real AI, cloud and data engineering, from someone who has built this for {{ p.stats.yearsExperience }} years. Whether you're just starting out or designing systems for a living, there's something here for you.</p>
          <div class="hub-signup" id="subscribe">
            {% set nfId = 'hero' %}{% set nfClass = 'hub-form hub-form-icon' %}{% set nfBtnClass = 'pf-btn pf-btn-primary' %}{% set nfAvatar = '/images/profile/hari_new.png' %}{% set nfPlaceholder = 'Your email address' %}{% set nfBtnIcon = true %}{% include "newsletter-form.njk" %}
            <p class="hub-form-note">Join the community. Free every week. Unsubscribe any time.</p>
          </div>
        </div>
      </div>
      {#- tools the lessons cover, scrolling; the list is doubled so the loop is seamless #}
      <div class="hub-marquee" aria-label="Tools covered">
        <ul>
          {%- for round in [1, 2] %}{% for t in portfolio.tools %}
          <li{% if round == 2 %} aria-hidden="true"{% endif %}><img src="{{ t.logo }}" alt="" width="20" height="20" loading="lazy" />{{ t.name }}</li>
          {%- endfor %}{% endfor %}
        </ul>
      </div>
    </section>

    <!-- 2. WHAT YOU GET -->
    <section class="hub-section" id="inside">
      <div class="pf-wrap">
        <header class="hub-head hub-reveal">
          <div><p class="hub-label">What you get</p><h2 class="hub-h2">A working <span class="hub-accent">system</span>, not theory</h2></div>
        </header>
        <div class="hub-tiles">
          <a class="hub-glass hub-light hub-tile hub-reveal" href="#join">
            <span class="ico3d ico3d-blue">{{ ico("mail") }}</span>
            <span class="hub-label">01 · Every issue</span>
            <span class="hub-tile-title">One useful lesson</span>
            <span class="hub-tile-text">Something about AI you can use the same day, with the prompt, the steps or the design behind it.</span>
          </a>
          <a class="hub-glass hub-light hub-tile hub-reveal" href="/guides/">
            <span class="ico3d ico3d-violet">{{ ico("course") }}</span>
            <span class="hub-label">02 · Guides</span>
            <span class="hub-tile-title">Free exam guides</span>
            <span class="hub-tile-text">Study guides for the Claude exams and Google Cloud Professional Cloud Architect, with the Databricks Data Engineer Professional guide on the way.</span>
          </a>
          <a class="hub-glass hub-light hub-tile hub-reveal" href="/guides/">
            <span class="ico3d ico3d-green">{{ ico("check") }}</span>
            <span class="hub-label">03 · Practice</span>
            <span class="hub-tile-title">Exam-style questions</span>
            <span class="hub-tile-text">{{ questions }} free questions for the Claude certifications, with every answer explained.</span>
          </a>
          <a class="hub-glass hub-light hub-tile hub-reveal" href="#field">
            <span class="ico3d ico3d-amber">{{ ico("db") }}</span>
            <span class="hub-label">04 · From the field</span>
            <span class="hub-tile-title">Real AI, cloud and data work</span>
            <span class="hub-tile-text">What actually happens on enterprise AI, cloud and data projects: the outages, the fixes and the trade-offs.</span>
          </a>
        </div>
      </div>
    </section>

    {% if editions.length %}
    <!-- 2a. THIS WEEK'S EDITION: the three newest BrainByte editions (Substack, via
         src/_data/editions.js). The newest is the big card; the next two sit below. -->
    {%- set edition = editions[0] %}
    <section class="hub-section" id="edition">
      <div class="pf-wrap">
        <header class="hub-head hub-reveal">
          <div><p class="hub-label">{{ nl.name }} · this week</p><h2 class="hub-h2">This week's <span class="hub-accent">edition</span></h2>
          <p class="hub-sub">The newest issues of {{ nl.name }}, a new one {{ nl.cadence }}.</p></div>
          <a href="/newsletter/" class="hub-textlink">Browse all editions <span aria-hidden="true">→</span></a>
        </header>
        <a class="hub-glass hub-light hub-edition hub-reveal" href="{{ edition.url }}">
          <span class="hub-edition-art{% if not edition.image %} is-empty{% endif %}">{% if edition.image %}<img src="{{ edition.image }}" alt="" loading="lazy" />{% else %}<span class="ico3d ico3d-lg ico3d-blue">{{ ico("mail") }}</span>{% endif %}</span>
          <span class="hub-edition-text">
            <span class="hub-label">Latest edition · {{ edition.date | longDate }}</span>
            <span class="hub-edition-title">{{ edition.title }}</span>
            {% if edition.subtitle %}<span class="hub-lead-text">{{ edition.subtitle }}</span>{% endif %}
            <span class="pf-btn pf-btn-primary">Read the edition <span aria-hidden="true">→</span></span>
          </span>
        </a>
        {%- if editions.length > 1 %}
        <div class="hub-editions">
          {%- for e in editions %}{% if loop.index > 1 and loop.index <= 3 %}
          <a class="hub-glass hub-light hub-card3 hub-reveal" href="{{ e.url }}">
            <span class="hub-card3-art{% if not e.image %} is-empty{% endif %}">{% if e.image %}<img src="{{ e.image }}" alt="" loading="lazy" />{% else %}<span class="ico3d ico3d-blue">{{ ico("mail") }}</span>{% endif %}</span>
            <span class="hub-card3-body">
              <span class="hub-meta">{{ e.date | longDate }}</span>
              <span class="hub-card3-title">{{ e.title }}</span>
            </span>
          </a>
          {%- endif %}{% endfor %}
        </div>
        {%- endif %}
      </div>
    </section>
    {% endif %}

    <!-- 2b. WHO IT'S FOR: one card per audience (audiences.json) -> /for/{slug}/ -->
    <section class="hub-section" id="for">
      <div class="pf-wrap">
        <header class="hub-head hub-reveal">
          <div><p class="hub-label">Who it's for</p><h2 class="hub-h2">Pick your <span class="hub-accent">track</span></h2>
          <p class="hub-sub">One newsletter, written for different readers. Start with the page that fits you.</p></div>
        </header>
        <div class="aud-others">
          {%- for o in audiences.list %}
          <a class="hub-glass hub-light aud-card hub-reveal" href="/for/{{ o.slug }}/">
            <span class="hub-pack-top"><span class="ico3d ico3d-{{ o.color }}">{{ ico(o.icon) }}</span>{% if o.status != "live" %}<span class="hub-tag hub-tag-dim">Coming soon</span>{% endif %}</span>
            <span class="hub-kit-title">For {{ o.name | lower }}</span>
            <span class="hub-meta">{{ o.who }}</span>
            <span class="hub-kit-text">{{ o.card }}</span>
            <span class="hub-textlink">{{ "Start here" if o.status == "live" else "Join the list" }} <span aria-hidden="true">→</span></span>
          </a>
          {%- endfor %}
        </div>
      </div>
    </section>

    <!-- 6. WHO WRITES IT (short; the full profile is /about/) -->
    <section class="hub-section" id="about">
      <div class="pf-wrap">
        <div class="hub-glass hub-light hub-about hub-reveal">
          <div class="hub-about-body">
            <p class="hub-label">Who writes this</p>
            <h2 class="hub-h2">Hi, I'm <span class="hub-accent">Hari.</span></h2>
            <p class="hub-about-text">I'm a data and AI architect. For {{ p.stats.yearsExperience }} years I've designed and shipped data platforms and GenAI systems for enterprise teams in retail, e-commerce, telecom and biotech. {{ nl.name }} is what I wish someone had told me on the way: what works in production, what breaks, and how to tell the difference early.</p>
            {%- set issuers = [] %}{% for c in p.certifications %}{% if issuers.indexOf(c.issuer) == -1 %}{% set issuers = (issuers.push(c.issuer), issuers) %}{% endif %}{% endfor %}
            <ul class="hub-pills hub-pills-left">
              <li><strong>{{ p.stats.yearsExperience }}</strong> years in data &amp; AI</li>
              <li><strong>{{ p.stats.certifications }}</strong> certifications</li>
              <li>{{ issuers | join(" · ") }}</li>
            </ul>
            <div class="hub-hero-ctas">
              <a href="/about/" class="pf-btn pf-btn-ghost">Full profile &amp; CV <span aria-hidden="true">→</span></a>
              {% if brainbyte.coaching.length %}<a href="{{ brainbyte.coaching[0].url }}" class="hub-textlink" target="_blank" rel="noopener">{% include "topmate-icon.njk" %}Book a 1:1 call on Topmate <span aria-hidden="true">↗</span></a>{% endif %}
            </div>
          </div>
          <img class="hub-about-photo" src="/images/profile/hari_new.png" alt="{{ p.name }}" width="320" height="320" loading="lazy" />
        </div>
      </div>
    </section>

    {% if resources.list.length %}
    <!-- 3b. FREE RESOURCES (src/_data/resources.js): the six newest guides,
         then a link to the full vault at /resources/ -->
    <section class="hub-section" id="resources">
      <div class="pf-wrap">
        <header class="hub-head hub-reveal">
          <div><p class="hub-label">Free resources</p><h2 class="hub-h2">Setups and prompts <span class="hub-accent">you can paste today</span></h2>
          <p class="hub-sub">Step-by-step guides for Claude, Claude Code and AI video. Every prompt ready to copy, a check after each step, and fixes for what goes wrong. No sign-up needed.</p></div>
          <a href="/resources/" class="hub-textlink">All {{ resources.list.length }} guides <span aria-hidden="true">→</span></a>
        </header>
        <div class="hub-kits rs-cards">
          {%- for r in resources.list %}{% if loop.index <= 6 %}{% include "rs-card.njk" %}{% endif %}{% endfor %}
        </div>
      </div>
    </section>
    {% endif %}

    {% if latest %}
    <!-- 4. FROM THE FIELD: the latest blog article as the big card, then the
         next three (newsletter editions have their own section above). -->
    <section class="hub-section" id="field">
      <div class="pf-wrap">
        <header class="hub-head hub-reveal">
          <div><p class="hub-label">From the field</p><h2 class="hub-h2">Real <span class="hub-accent">AI, cloud and data</span> work, written down</h2>
          <p class="hub-sub">Long-form articles from enterprise projects on GenAI and agents, cloud platforms and data engineering: what I built, what broke and what I'd do again.</p></div>
          <a href="/blog/" class="hub-textlink">All {{ collections.posts.length }} articles <span aria-hidden="true">→</span></a>
        </header>
        {%- set lthumb = latest.data.cover or (latest.templateContent | firstImage) %}
        <a class="hub-glass hub-light hub-edition hub-reveal" href="{{ latest.url }}">
          <span class="hub-edition-art{% if not lthumb %} is-empty{% endif %}">{% if lthumb %}<img src="{{ lthumb }}" alt="" loading="lazy" />{% else %}<span class="ico3d ico3d-lg ico3d-blue">{{ ico("db") }}</span>{% endif %}</span>
          <span class="hub-edition-text">
            <span class="hub-label">Latest · {{ latest.date | postDate }} · {{ latest.templateContent | readTime }} min read</span>
            <span class="hub-edition-title">{{ latest.data.title }}</span>
            {% if latest.data.subtitle or latest.data.excerpt %}<span class="hub-lead-text">{{ latest.data.subtitle or latest.data.excerpt }}</span>{% endif %}
            <span class="pf-btn pf-btn-primary">Read the article <span aria-hidden="true">→</span></span>
          </span>
        </a>
        <div class="hub-editions">
          {% for post in collections.posts %}{% if loop.index > 1 and loop.index <= 4 %}
          {%- set th = post.data.cover or (post.templateContent | firstImage) %}
          <a class="hub-glass hub-light hub-card3 hub-reveal" href="{{ post.url }}">
            <span class="hub-card3-art{% if not th %} is-empty{% endif %}">{% if th %}<img src="{{ th }}" alt="" loading="lazy" />{% else %}<span class="ico3d ico3d-violet">{{ ico("spark") }}</span>{% endif %}</span>
            <span class="hub-card3-body">
              <span class="hub-meta">{{ post.date | postDate }} · {{ post.templateContent | readTime }} min</span>
              <span class="hub-card3-title">{{ post.data.title }}</span>
            </span>
          </a>
          {% endif %}{% endfor %}
        </div>
      </div>
    </section>
    {% endif %}

    <!-- 7. SUBSCRIBE -->
    <section class="hub-section hub-join" id="join">
      <div class="pf-wrap">
        <div class="hub-join-panel hub-reveal">
          <p class="hub-label">{{ nl.name }}</p>
          <h2 class="hub-join-title">Get the next <span class="hub-accent">lesson</span> first.</h2>
          <p class="hub-sub">{{ nl.tagline }}, in your inbox {{ nl.cadence }}. Free, and you can unsubscribe in one click.</p>
          {% set nfId = 'join' %}{% set nfClass = 'hub-form hub-form-icon' %}{% set nfBtnClass = 'pf-btn pf-btn-primary' %}{% set nfAvatar = '/images/profile/hari_new.png' %}{% include "newsletter-form.njk" %}
          <p class="hub-join-contact">Prefer to talk? <a href="mailto:{{ p.contact.email }}">Email</a> · <a href="{{ p.contact.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>{% if p.contact.topmate %} · <a href="{{ p.contact.topmate }}" target="_blank" rel="noopener">{% include "topmate-icon.njk" %}Book a 1:1 call</a>{% endif %}</p>
        </div>
      </div>
    </section>

  </main>

  {% include "hub-footer.njk" %}

  <script src="/assets/galaxy.js" defer></script>
  <script src="/assets/space.js" defer></script>
  <script src="/assets/hub.js" defer></script>
  <link rel="stylesheet" href="/assets/ask-hari-widget.css">
  <script src="/assets/ask-hari-widget.js" defer></script>
</body>
</html>
