---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | escape }}</title>
  <subtitle>{{ site.description | escape }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml" />
  <link href="{{ site.url }}/" rel="alternate" type="text/html" />
  {% if collections.posts | length %}<updated>{{ collections.posts[0].date | dateToRfc3339 }}</updated>{% endif %}
  <id>{{ site.url }}/</id>
  <author>
    <name>{{ site.author | escape }}</name>
  </author>
  {% for post in collections.posts %}
  <entry>
    <title>{{ post.data.title | escape }}</title>
    <link href="{{ site.url }}{{ post.url }}" rel="alternate" type="text/html" />
    <id>{{ site.url }}{{ post.url }}</id>
    <updated>{{ post.date | dateToRfc3339 }}</updated>
    {% if post.data.excerpt %}<summary>{{ post.data.excerpt | escape }}</summary>{% endif %}
    {% for tag in post.data.tags %}<category term="{{ tag | escape }}" />
    {% endfor %}
  </entry>
  {% endfor %}
</feed>
