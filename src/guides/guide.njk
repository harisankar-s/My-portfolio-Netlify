---
layout: hub-page.njk
pagination:
  data: bbLiveGuides
  size: 1
  alias: guide
permalink: "/guides/{{ guide.slug }}/index.html"
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "{{ guide.title }}"
  pageTitle: "{{ guide.seoTitle }}"
  description: "{{ guide.description }}"
---
{#- A free guide, after charliehills.ai/guides/*: the pitch and "What's inside"
    up top, the intro and first lesson open to everyone, then a BrainByte
    BrainByte signup that unlocks the rest on the page (and the PDF). The gate is
    a soft one: everything is in the HTML (readers without JS and search
    engines see it all); /assets/guides.js hides the locked part until the form is
    sent, and remembers it in localStorage for every guide. Content lives in
    src/_data/guides.json. -#}
{%- set lessonCount = guide.domains | sumLength("lessons") -%}
{%- set pack = brainbyte.practice | findBy("exam", guide.packExam) -%}
{%- set dWord = guide.domainWord or "Domain" -%}
{#- A domain's label and weight line: guides.json can set `tag` (e.g. "Case
    studies") and `weightLabel` for a part that is not one exam section. -#}
{#- A domain can also set `group` (a heading in "What's inside" and the
    section picker) and `unit` ("services" instead of "lessons"). -#}
{%- macro dWeight(d) %}{% if d.weightLabel %}{{ d.weightLabel }}{% elif d.weight %}{{ d.weight }}% of the exam{% endif %}{% endmacro -%}
{%- macro dTag(d, dWord) %}{{ d.tag or (dWord + " " + d.n) }}{% if d.weightLabel or d.weight %} · {{ dWeight(d) }}{% endif %}{% endmacro -%}
{%- set maxWeight = 0 -%}{%- for d in guide.domains %}{% if d.weight > maxWeight %}{% set maxWeight = d.weight %}{% endif %}{% endfor -%}
{%- set pdfUrl = '/files/' + guide.pdf -%}

<div class="bg-guide" data-bb-guide>

  <!-- 1. HEADER: pitch left, what's inside right -->
  <header class="bg-head" id="hero">
    <div class="bg-head-grid">
      <div class="bg-head-text">
        <a class="bg-back" href="/guides/">← All exam prep</a>
        <p class="bg-kicker">{{ guide.kicker }}</p>
        <h1 class="bg-title">{{ guide.title }}</h1>
        <p class="bg-pitch">{{ guide.pitch }}</p>
        <div class="bg-byline">
          <img src="/images/profile/hari_new.png" alt="" width="40" height="40" />
          <span><b>{{ site.author }}</b><br />Added {{ guide.added | longDate }} · {{ guide.edition }} · Free</span>
        </div>
        <ul class="bg-stats">
          {%- for s in guide.stats %}<li><strong>{{ s.n }}</strong> {{ s.label }}</li>{% endfor %}
        </ul>
        <div class="bg-head-ctas">
          <a class="pf-btn pf-btn-primary" href="#unlock" data-bb-locked-only>Read the full guide, free</a>
          <a class="pf-btn pf-btn-primary" href="#domain-1" data-bb-unlocked-only hidden>Start reading</a>
          <a class="pf-btn pf-btn-ghost" href="{{ pdfUrl }}" download data-bb-unlocked-only hidden>Download the PDF ({{ guide.pdfPages }} pages)</a>
        </div>
        {% if pack and pack.status == 'live' %}<p class="bg-pair">Pair it with the <a href="{{ pack.url }}" target="_blank" rel="noopener">{% include "topmate-icon.njk" %}free {{ pack.count }}-question {{ guide.exam }} practice PDF (free download on Topmate) ↗</a></p>{% endif %}
      </div>

      <aside class="bg-inside" aria-label="What's inside">
        <p class="bg-small">What's inside</p>
        <ol class="bg-inside-list">
          <li><a href="#how-to-use"><span class="bg-inside-num">0</span><span class="bg-inside-name">How to use these tips<small>{{ guide.insideIntro }}</small></span></a></li>
          {%- for d in guide.domains %}
          {%- if d.group and (loop.first or guide.domains[loop.index0 - 1].group != d.group) %}
          <li class="bg-inside-group" aria-hidden="true">{{ d.group }}</li>
          {%- endif %}
          <li><a href="#domain-{{ d.n }}">
            <span class="bg-inside-num">{{ d.n }}</span>
            <span class="bg-inside-name">{{ d.title }}<small>{{ d.lessons.length }} {{ d.unit or "lessons" }}{% if d.weightLabel or d.weight %} · {{ dWeight(d) }}{% endif %}</small>
              {% if d.weight and not d.weightLabel %}<span class="bg-bar" aria-hidden="true"><i style="width: {{ (d.weight / maxWeight * 100) | round }}%"></i></span>{% endif %}</span>
          </a></li>
          {%- endfor %}
        </ol>
      </aside>
    </div>
  </header>

  <div class="bg-wrap"><div class="bg-paper">
  {#- Reading bar (guides.js), shown once the guide is unlocked: part tabs when
      guides.json sets `parts` (e.g. Exam guide / Service guide), then a sticky
      row of section chips and the "one section at a time" switch. -#}
  <div class="bg-navbar" data-bb-navbar data-bb-unlocked-only hidden>
    {%- if guide.parts %}
    <div class="bg-parts" role="tablist" aria-label="Parts of the guide">
      {%- for p in guide.parts %}
      <button type="button" role="tab" class="bg-part" data-bb-part="{{ p.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}"><b>{{ p.name }}</b><small>{{ p.sub }}</small></button>
      {%- endfor %}
    </div>
    {%- endif %}
    <div class="bg-navrow">
      <nav class="bg-chips" data-bb-chips aria-label="Sections">
        <a class="bg-chip" href="#how-to-use" data-sec="0" data-part="{{ guide.parts[0].id if guide.parts else '' }}">Start here</a>
        {%- for d in guide.domains %}
        <a class="bg-chip" href="#domain-{{ d.n }}" data-sec="{{ d.n }}" data-part="{{ d.part or '' }}"><span class="bg-chip-n">{{ d.n }}</span> {{ d.short or d.title }}</a>
        {%- endfor %}
      </nav>
      <button type="button" class="bg-mode" data-bb-sections aria-pressed="false">One section at a time</button>
    </div>
  </div>
  <!-- 2. FREE PART: how to use + exam facts + lesson 1.1 -->
  <section>
    <div class="bg-body">
      <h2 class="bg-h2" id="how-to-use">How to use these tips</h2>
      <p class="bg-p">{{ guide.intro.lead }}</p>
      <div class="bg-callout">
        {%- for part in guide.intro.parts %}<p><b>{{ part[0] }}</b> {{ part[1] }}</p>{% endfor %}
      </div>
      <p class="bg-p"><b>Work through each lesson in three passes:</b></p>
      <ol class="bg-passes">
        {%- for ps in guide.intro.passes %}<li><span><b>{{ ps[0] }}</b> {{ ps[1] }}</span></li>{% endfor %}
      </ol>
      <p class="bg-p bg-note">{{ guide.intro.versionNote }}</p>

      <h3 class="bg-h3">Exam facts</h3>
      {% if guide.intro.factsLead %}<p class="bg-p bg-muted">{{ guide.intro.factsLead }}</p>{% endif %}
      <ul class="bg-facts">
        {%- for f in guide.intro.facts %}<li><strong>{{ f.n }}</strong><span>{{ f.label }}</span>{% if f.sub %}<small>{{ f.sub }}</small>{% endif %}</li>{% endfor %}
      </ul>

      {%- if guide.intro.metaRules %}
      <h3 class="bg-h3" id="meta-rules">{{ guide.intro.metaTitle }}</h3>
      <p class="bg-p bg-muted">{{ guide.intro.metaLead }}</p>
      <ol class="bg-meta-rules">
        {%- for m in guide.intro.metaRules %}<li><b>{{ m[0] }}</b><span>{{ m[1] | ticks | safe }}</span></li>{% endfor %}
      </ol>
      {%- else %}
      <h3 class="bg-h3">Rules that come up again and again</h3>
      <ul class="bg-rules">
        {%- for r in guide.intro.recurring %}<li>{{ r | ticks | safe }}</li>{% endfor %}
      </ul>
      {%- endif %}
      <p class="bg-fine">{{ guide.intro.disclaimer }}</p>

      <div class="bg-toolbar">
        <button type="button" class="bg-cover-btn" data-bb-cover aria-pressed="false">Cover the right answers</button>
        <a class="bg-cover-btn bg-pdf-btn" href="{{ pdfUrl }}" download data-bb-unlocked-only hidden>Download PDF</a>
        <span class="bg-fine">Cover hides every best answer and its reason, so you can decide first. Tap a card to reveal it.</span>
      </div>

      {%- set d1 = guide.domains[0] %}
      <div class="bg-domain" id="domain-{{ d1.n }}" data-part="{{ d1.part or '' }}">
        <p class="bg-domain-tag">{{ dTag(d1, dWord) }}</p>
        <h2 class="bg-h2">{{ d1.title }}</h2>
        <p class="bg-p bg-muted">{{ d1.sub }}</p>
      </div>
      {%- set lesson = d1.lessons[0] %}{% include "bb-lesson.njk" %}

      <!-- 3. THE GATE -->
      <div class="bg-gate" id="unlock" data-bb-locked-only>
        <p class="bg-gate-lead">That's the first lesson. The other {{ lessonCount - 1 }} are free too.</p>
        <div class="bg-gate-card">
          <p class="bg-small">Free · one sign-up opens every guide</p>
          <h2 class="bg-gate-title">Get the full {{ guide.title }}, free</h2>
          <p class="bg-p">The guide comes with my free newsletter, {{ site.newsletter.name }}. {{ site.newsletter.tagline }}, a new issue {{ site.newsletter.cadence }}. Enter your email, type the 6-digit code we send you, and the guide opens right here, with the PDF to keep.</p>
          {% set nfId = 'gate-' + guide.slug %}{% set nfClass = 'bg-gate-form' %}{% set nfBtnClass = 'pf-btn pf-btn-primary' %}{% set nfGate = true %}{% set nfBtnText = 'Open the guide' %}{% include "newsletter-form.njk" %}{% set nfGate = false %}{% set nfBtnText = '' %}
          <form class="bg-gate-form bg-otp" data-bb-otp hidden>
            <label class="nl-sr" for="otp-{{ guide.slug }}">6-digit code</label>
            <input id="otp-{{ guide.slug }}" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="6-digit code" required />
            <button type="submit" class="pf-btn pf-btn-primary">Verify and open</button>
          </form>
          <p class="bg-otp-msg" data-bb-otp-msg role="status" aria-live="polite" hidden></p>
          <p class="bg-fine" data-bb-otp-links hidden><button type="button" class="bg-linkbtn" data-bb-otp-resend>Send a new code</button> · <button type="button" class="bg-linkbtn" data-bb-otp-change>Use a different email</button></p>
          <p class="bg-fine" data-bb-gate-fine>We email you a code to check it's really you. Already subscribed? Same steps, and you won't be signed up twice. Unsubscribe any time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. LOCKED PART: every other lesson -->
  <section class="bg-locked" data-bb-locked aria-label="The rest of the guide">
    <div class="bg-body">
      {%- for lesson in d1.lessons %}{% if not loop.first %}{% include "bb-lesson.njk" %}{% endif %}{% endfor %}
      {%- for d in guide.domains %}{% if not loop.first %}
      <div class="bg-domain" id="domain-{{ d.n }}" data-part="{{ d.part or '' }}">
        <p class="bg-domain-tag">{{ dTag(d, dWord) }}</p>
        <h2 class="bg-h2">{{ d.title }}</h2>
        <p class="bg-p bg-muted">{{ d.sub }}</p>
      </div>
      {%- for lesson in d.lessons %}{% include "bb-lesson.njk" %}{% endfor %}
      {%- endif %}{% endfor %}

      <nav class="bg-pager" data-bb-pager hidden aria-label="Guide sections">
        <button type="button" class="bg-pager-btn" data-bb-prev><span aria-hidden="true">←</span> <span data-bb-prev-label>Previous</span></button>
        <label class="bg-pager-jump"><span class="bg-small" data-bb-count></span>
          <select data-bb-jump aria-label="Go to section">
            <option value="0">How to use these tips</option>
            {%- for d in guide.domains %}
            {%- if d.group and (loop.first or guide.domains[loop.index0 - 1].group != d.group) %}{% if not loop.first %}</optgroup>{% endif %}<optgroup label="{{ d.group }}">{% endif %}
            <option value="{{ d.n }}">{% if d.group == "Service guide" %}{{ d.n }}. {{ d.title }}{% else %}{{ d.tag or (dWord + " " + d.n) }}: {{ d.title }}{% endif %}</option>
            {%- if d.group and loop.last %}</optgroup>{% endif %}
            {%- endfor %}
          </select>
        </label>
        <button type="button" class="bg-pager-btn bg-pager-next" data-bb-next><span data-bb-next-label>Next</span> <span aria-hidden="true">→</span></button>
      </nav>

      <div class="bg-end">
        <h2 class="bg-h2">Thank you for studying with this guide.</h2>
        {% if guide.endNote and guide.endNote != "Thank you for studying with this guide." %}<p class="bg-p">{{ guide.endNote }}</p>{% endif %}
        <p class="bg-p">{{ guide.pairWith }}</p>
        <div class="bg-head-ctas">
          <a class="pf-btn pf-btn-primary" href="{{ pdfUrl }}" download>Download the PDF ({{ guide.pdfPages }} pages)</a>
          {% if pack %}<a class="pf-btn bg-btn-light" href="{{ pack.url }}" target="_blank" rel="noopener">{% include "topmate-icon.njk" %}Download the free {{ pack.count }}-question {{ guide.exam }} PDF ↗</a>{% endif %}
        </div>
      </div>
    </div>
  </section>
  </div></div>

  <!-- 5. MORE EXAM PREP: the other exams (exams.json), guide + practice -->
  <section class="bg-more">
    <div class="bg-more-inner">
      <p class="hub-label">More free exam prep</p>
      <h2 class="hub-h2">More free <span class="hub-accent">exam guides</span></h2>
      <div class="ep-grid">
        {%- for exam in exams %}{% if exam.guide != guide.slug %}{% include "exam-prep-card.njk" %}{% endif %}{% endfor %}
        {%- for t in brainbyte.tracks %}{% if t.testsOnly %}{% include "tests-card.njk" %}{% endif %}{% endfor %}
      </div>
      <p class="hub-sub" style="margin-top:24px">A Databricks Certified Data Engineer Professional guide is on the way. <a class="hub-textlink" href="/guides/">All exam prep <span aria-hidden="true">→</span></a></p>
      {%- if resources.list.length %}
      <p class="hub-label" style="margin-top:48px">Free resources · no sign-up</p>
      <h2 class="hub-h2">Setups and prompts <span class="hub-accent">you can paste today</span></h2>
      <div class="hub-kits rs-cards" style="margin-top:24px">
        {%- for r in resources.list %}{% if loop.index <= 3 %}{% include "rs-card.njk" %}{% endif %}{% endfor %}
      </div>
      <p class="hub-sub" style="margin-top:20px"><a class="hub-textlink" href="/resources/">All {{ resources.list.length }} free resources <span aria-hidden="true">→</span></a></p>
      {%- endif %}
    </div>
  </section>
</div>
